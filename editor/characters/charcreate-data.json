    {
      "id": "darkelf",
      "name": "Dark Elf",
      "genders": [
        "male",
        "female"
      ],
      "classes": [
        {
          "id": "dark_fighter",
          "name": "Dark Fighter",
          "type": "fighter",
          "classId": 31,
          "baseStats": {
            "STR": 41,
            "DEX": 34,
            "CON": 32,
            "INT": 25,
            "WIT": 12,
            "MEN": 26
          },
          "description": "\"…Quiet. Why do you talk so much? There's no need for strategy or plans-you need just slay the enemy without a word.\"\r\n\r\nDark Elf Fighters are dangerous close-combat fighters who rely on their speed and agility to give them an edge in battle. Letting down one’s guard when facing them may lead to a quick and painful death from their flashing cold blades."
        },
        {
          "id": "dark_mystic",
          "name": "Dark Mystic",
          "type": "mage",
          "classId": 38,
          "baseStats": {
            "STR": 23,
            "DEX": 23,
            "CON": 24,
            "INT": 44,
            "WIT": 19,
            "MEN": 37
          },
          "description": "\"I call upon the awesome energies of the great Gran Kain to annihilate my enemies and erase their names from the world!\"\r\n\r\nDark Elf Mystics are infamous for their ability to command dark magic. They relish  their powerful attack spells that can smite an enemy with a single word. Some say that their innate magical abilities surpass even those of the Elves."
        }
      ],
