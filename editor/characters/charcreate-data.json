    {
      "id": "orc",
      "name": "Orc",
      "genders": [
        "male",
        "female"
      ],
      "classes": [
        {
          "id": "orc_fighter",
          "name": "Orc Fighter",
          "type": "fighter",
          "classId": 44,
          "baseStats": {
            "STR": 40,
            "DEX": 26,
            "CON": 47,
            "INT": 18,
            "WIT": 12,
            "MEN": 27
          },
          "description": "\"You fools dare to block my path?! Do you truly believe that your puny bodies and those flimsy scraps of metal will withstand my attack?\"\r\n\r\nNo one can match the might of an Orc Fighter when it comes to pure physical strength. With their unflagging endurance and their incredible stubbornness, they are a fearful presence on the battlefield that no one wishes to face."
        },
        {
          "id": "orc_mystic",
          "name": "Orc Mystic",
          "type": "mage",
          "classId": 49,
          "baseStats": {
            "STR": 27,
            "DEX": 24,
            "CON": 31,
            "INT": 31,
            "WIT": 15,
            "MEN": 42
          },
          "description": "\"In the name of the eternal fire, may our enemies be burned, boiled, and roasted! Scour them mercilessly with flame, and drive them from our path!\"\r\nTheir command of ancient magics has given Orc Mystics tremendous political influence within Orc society. As Orcs, they are physically stronger than Mages of other races, but most believe their magic effects to be weaker."
        }
      ],
