        {
          "id": "human_fighter",
          "name": "Human Fighter",
          "type": "fighter",
          "classId": 0,
          "baseStats": {
            "STR": 40,
            "DEX": 30,
            "CON": 43,
            "INT": 21,
            "WIT": 11,
            "MEN": 25
          },
          "description": "\"Even if my heart should cease to beat, my sword and honor shall live forever!\"\r\n\r\nFighters possess superior strength and dexterity. They pride themselves as being the most skilled in close-range physical combat, mainly using swords and other handheld weapons.  They may also choose to focus on long-range attacks to develop into archers later in their careers."
        },
        {
          "id": "human_mystic",
          "name": "Human Mystic",
          "type": "mage",
          "classId": 10,
          "baseStats": {
            "STR": 22,
            "DEX": 21,
            "CON": 27,
            "INT": 41,
            "WIT": 20,
            "MEN": 39
          },
          "description": "\"Burn, burn bright, my fierce white flames. Illuminate the darkness and destroy those who dare to attack us.\"\r\n\r\nMystics study the ways of sorcery, and may summon magical creatures, cure grievous wounds, cast deadly attack spells, and create other wondrous miracles through the power of their intellect."
        }
