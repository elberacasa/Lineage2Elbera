+		return getMemos().getBool("autoloot", Config.AUTO_LOOT_RAID);
+	}
+	
+	/**
+	 * @return True if autoloot of herbs is enabled for this {@link Player}, based on its own toggle, or on {@link Config#AUTO_LOOT_HERBS} if no toggle is set.
+	 */
+	public boolean isAutoLootHerbs()
+	{
+		return getMemos().getBool("autoloot", Config.AUTO_LOOT_HERBS);
+	}
+	
+	/**
+	 * @return True if experience gain is blocked for this {@link Player} (.expoff), or false otherwise.
+	 */
+	public boolean isExpBlocked()
+	{
+		return getMemos().getBool("expBlocked", false);
+	}
+	
