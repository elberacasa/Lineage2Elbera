@@ -0,0 +1,20 @@
+package net.sf.l2j.gameserver.handler;
+
+import net.sf.l2j.gameserver.model.actor.Player;
+
+public interface IVoicedCommandHandler
+{
+	/**
+	 * This is the worker method that is called when a {@link Player} uses a voiced command (chat beginning with a dot, eg .menu), or a {@code voiced_} bypass.
+	 * @param command : The voiced command itself, without the leading dot.
+	 * @param player : The {@link Player} who used the command.
+	 * @param params : The command parameters, or an empty {@link String} if none.
+	 * @return True if the command was successfully processed, false otherwise.
+	 */
+	boolean useVoicedCommand(String command, Player player, String params);
+	
+	/**
+	 * @return The list of voiced commands (without leading dot) handled by this handler.
+	 */
+	String[] getVoicedCommandList();
+}
diff --git a/aCis_gameserver/java/net/sf/l2j/gameserver/handler/VoicedCommandHandler.java b/aCis_gameserver/java/net/sf/l2j/gameserver/handler/VoicedCommandHandler.java
new file mode 100644
index 00000000..9972b7f8
--- /dev/null
+++ b/aCis_gameserver/java/net/sf/l2j/gameserver/handler/VoicedCommandHandler.java
@@ -0,0 +1,26 @@
+package net.sf.l2j.gameserver.handler;
+
+public class VoicedCommandHandler extends AbstractHandler<String, IVoicedCommandHandler>
+{
+	protected VoicedCommandHandler()
+	{
+		super(IVoicedCommandHandler.class, "voicedcommandhandlers");
+	}
+	
+	@Override
+	protected void registerHandler(IVoicedCommandHandler handler)
+	{
+		for (String id : handler.getVoicedCommandList())
+			_entries.put(id, handler);
+	}
+	
+	public static VoicedCommandHandler getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+	
+	private static class SingletonHolder
+	{
+		protected static final VoicedCommandHandler INSTANCE = new VoicedCommandHandler();
+	}
+}
diff --git a/aCis_gameserver/java/net/sf/l2j/gameserver/handler/voicedcommandhandlers/Menu.java b/aCis_gameserver/java/net/sf/l2j/gameserver/handler/voicedcommandhandlers/Menu.java
new file mode 100644
index 00000000..88b20402
--- /dev/null
+++ b/aCis_gameserver/java/net/sf/l2j/gameserver/handler/voicedcommandhandlers/Menu.java
@@ -0,0 +1,161 @@
+package net.sf.l2j.gameserver.handler.voicedcommandhandlers;
+
+import net.sf.l2j.Config;
+import net.sf.l2j.gameserver.handler.IVoicedCommandHandler;
+import net.sf.l2j.gameserver.model.actor.Player;
+import net.sf.l2j.gameserver.network.serverpackets.NpcHtmlMessage;
+
+/**
+ * The .menu voiced command, and its related QoL commands (.expon, .expoff, .autoloot, .offline).<br>
+ * <br>
+ * Those commands expose, equally for everyone, the server-side automation toggles : per-player autoloot, experience gain block, and offline shop logout. An info / message-of-the-day page is also part of the menu.<br>
+ * <br>
+ * Toggles are stored per-player into character memos, and survive relogs.
+ */
+public class Menu implements IVoicedCommandHandler
+{
+	private static final String[] VOICED_COMMANDS =
+	{
+		"menu",
+		"expon",
+		"expoff",
+		"autoloot",
+		"offline"
+	};
+	
+	@Override
+	public boolean useVoicedCommand(String command, Player player, String params)
+	{
+		switch (command)
+		{
+			case "menu":
+			{
+				// The menu also handles its own sub-actions, called from bypass links.
+				if (params == null || params.isEmpty())
+					showMainPage(player);
+				else
+				{
+					switch (params.split(" ")[0])
+					{
+						case "autoloot" -> toggleAutoLoot(player);
+						case "exp" -> toggleExp(player);
+						case "info" -> showInfoPage(player);
+						case "offline" -> doOffline(player);
+						default -> showMainPage(player);
+					}
+				}
+				break;
+			}
+			
+			case "expon":
+				setExpBlocked(player, false);
+				break;
+			
+			case "expoff":
+				setExpBlocked(player, true);
+				break;
+			
+			case "autoloot":
+				toggleAutoLoot(player);
+				break;
+			
+			case "offline":
+				doOffline(player);
+				break;
+		}
+		return true;
+	}
+	
+	@Override
+	public String[] getVoicedCommandList()
+	{
+		return VOICED_COMMANDS;
+	}
+	
+	/**
+	 * Toggle the per-player autoloot, and show back the main page.
+	 * @param player : The {@link Player} to affect.
+	 */
+	private static void toggleAutoLoot(Player player)
+	{
+		final boolean enabled = !player.isAutoLoot();
+		player.getMemos().set("autoloot", enabled);
+		player.sendMessage("El AutoLoot ahora esta " + (enabled ? "ACTIVADO" : "DESACTIVADO") + ".");
+		
+		showMainPage(player);
+	}
+	
+	/**
+	 * Toggle the experience gain block, and show back the main page.
+	 * @param player : The {@link Player} to affect.
+	 */
+	private static void toggleExp(Player player)
+	{
+		setExpBlocked(player, !player.isExpBlocked());
+		showMainPage(player);
+	}
+	
+	/**
+	 * Set the experience gain block.
+	 * @param player : The {@link Player} to affect.
+	 * @param blocked : True to block experience gain (.expoff), false to allow it (.expon).
+	 */
+	private static void setExpBlocked(Player player, boolean blocked)
+	{
+		player.getMemos().set("expBlocked", blocked);
+		player.sendMessage("La ganancia de experiencia ahora esta " + (blocked ? "BLOQUEADA (usa .expon para reactivarla)" : "PERMITIDA") + ".");
+	}
+	
+	/**
+	 * Logout with an active private store, staying in the world as an offline trader.
+	 * @param player : The {@link Player} to affect.
+	 */
+	private static void doOffline(Player player)
+	{
+		if (!Config.OFFLINE_TRADE_ENABLE)
+		{
+			player.sendMessage("Las tiendas offline estan desactivadas en este servidor.");
+			return;
+		}
+		
+		if (!player.isInStoreMode())
+		{
+			player.sendMessage("Necesitas una tienda privada activa (compra, venta o fabricacion) para usar .offline.");
+			return;
+		}
+		
+		if (!player.canOpenOfflineShop())
+		{
+			player.sendMessage("No puedes desconectarte con tu tienda en tu estado actual.");
+			return;
+		}
+		
+		player.sendMessage("Tu tienda seguira activa mientras estes desconectado.");
+		player.logout(true);
+	}
+	
+	/**
+	 * Show the menu main page, with the current toggles states.
+	 * @param player : The {@link Player} to show the page to.
+	 */
+	private static void showMainPage(Player player)
+	{
+		final NpcHtmlMessage html = new NpcHtmlMessage(0);
+		html.setFile("data/html/mods/menu.htm");
+		html.replace("%autoloot%", player.isAutoLoot() ? "<font color=\"66FF66\">ON</font>" : "<font color=\"FF6666\">OFF</font>");
+		html.replace("%exp%", player.isExpBlocked() ? "<font color=\"FF6666\">BLOCKED</font>" : "<font color=\"66FF66\">ALLOWED</font>");
+		html.replace("%offline%", Config.OFFLINE_TRADE_ENABLE ? "available" : "disabled");
+		player.sendPacket(html);
+	}
+	
+	/**
+	 * Show the info / message-of-the-day page.
+	 * @param player : The {@link Player} to show the page to.
+	 */
+	private static void showInfoPage(Player player)
+	{
+		final NpcHtmlMessage html = new NpcHtmlMessage(0);
+		html.setFile("data/html/mods/info.htm");
+		player.sendPacket(html);
+	}
+}
