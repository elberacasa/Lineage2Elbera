+	 */
+	public boolean canOpenOfflineShop()
+	{
+		// Offline trade feature is disabled.
+		if (!Config.OFFLINE_TRADE_ENABLE)
+			return false;
+		
+		// No active store, or package sale stores (which can't be kept offline).
+		if (!isInStoreMode() || _operateType == OperateType.PACKAGE_SELL)
+			return false;
+		
+		// Manufacture stores need their own Config.
