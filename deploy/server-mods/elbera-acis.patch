+		// Restricted states.
+		if (isAlikeDead() || isInCombat() || isInDuel() || getPvpFlag() > 0 || isMounted() || isInOlympiadMode() || isInObserverMode() || isFestivalParticipant() || isInJail() || isCursedWeaponEquipped() || isInsideZone(ZoneId.NO_STORE))
+			return false;
+		
+		return true;
+	}
+	
+	/**
+	 * Keep this {@link Player} in the world as an offline trader. The associated {@link GameClient} is already detached at that point.
+	 */
+	public void becomeOfflineTrader()
+	{
+		_isOfflineTrader = true;
+		
+		// Unsummon the pet, if any.
+		if (getSummon() != null)
+			getSummon().unSummon(this);
+		
+		// Mark the Player as offline, and save its current state.
+		setOnlineStatus(false, true);
+		store();
+		
+		LOGGER.info("{} stays in world as an offline trader ({}).", getName(), _operateType);
+	}
+	
+	/**
+	 * Stop the offline trade for this {@link Player} : the store is closed and the Player stands up. Used when the Player logs back in, before its {@link GameClient} is attached.
+	 */
+	public void stopOfflineTrade()
+	{
+		_isOfflineTrader = false;
+		
+		// Close the store and stand up.
+		setOperateType(OperateType.NONE);
+		standUp();
+	}
+	
+	/**
+	 * @return True if autoloot of regular drops is enabled for this {@link Player}, based on its own toggle, or on {@link Config#AUTO_LOOT} if no toggle is set.
+	 */
+	public boolean isAutoLoot()
+	{
+		return getMemos().getBool("autoloot", Config.AUTO_LOOT);
+	}
+	
+	/**
+	 * @return True if autoloot of raid drops is enabled for this {@link Player}, based on its own toggle, or on {@link Config#AUTO_LOOT_RAID} if no toggle is set.
+	 */
+	public boolean isAutoLootRaid()
