@@ -525,9 +525,24 @@ static void Init(const char *caption)
 	SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
 //	SDL_GL_SetAttribute(SDL_GL_ACCELERATED_VISUAL, 1);
 
+	// l2vzla: headless/batch capture support
+	// UMODEL_WINSIZE=WxH overrides the default 800x600 viewport
+	if (const char* sz = getenv("UMODEL_WINSIZE"))
+	{
+		int w = 0, h = 0;
+		if (sscanf(sz, "%dx%d", &w, &h) == 2 && w > 0 && h > 0)
+		{
+			Viewport::Size.X = w;
+			Viewport::Size.Y = h;
+		}
+	}
+	// UMODEL_HIDDEN=1 creates an invisible window (GL rendering still works)
+	Uint32 windowFlags = SDL_WINDOW_OPENGL|SDL_WINDOW_RESIZABLE;
+	windowFlags |= getenv("UMODEL_HIDDEN") ? SDL_WINDOW_HIDDEN : SDL_WINDOW_SHOWN;
+
 	sdlWindow = SDL_CreateWindow(caption,
 		SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, Viewport::Size.X, Viewport::Size.Y,
-		SDL_WINDOW_OPENGL|SDL_WINDOW_SHOWN|SDL_WINDOW_RESIZABLE);
+		windowFlags);
 	if (!sdlWindow)
 	{
 		const char* errorString = SDL_GetError();
