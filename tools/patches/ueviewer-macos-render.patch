 		ResetView();			// may be initialized before VisualizerLoop call
+	// l2vzla: UMODEL_YAW/UMODEL_PITCH rotate the initial camera (degrees, added to defaults)
+	if (getenv("UMODEL_YAW") || getenv("UMODEL_PITCH") || getenv("UMODEL_DIST"))
+	{
+		if (const char* e = getenv("UMODEL_YAW"))   viewAngles[YAW]   += atof(e);
+		if (const char* e = getenv("UMODEL_PITCH")) viewAngles[PITCH] += atof(e);
+		if (const char* e = getenv("UMODEL_DIST"))  viewDist *= atof(e);
+		// recompute camera origin for the new angles (same math as FocusCameraOnPoint)
+		CAxis axis;
+		axis.FromEuler(viewAngles);
+		VectorScale(axis[0], -viewDist, viewOrigin);
