diff --git a/Exporters/ExportMaterial.cpp b/Exporters/ExportMaterial.cpp
index 527d6a2..567c700 100644
--- a/Exporters/ExportMaterial.cpp
+++ b/Exporters/ExportMaterial.cpp
@@ -12,6 +12,26 @@ void ExportMaterial(const UUnrealMaterial* Mat)
 {
 	guard(ExportMaterial);
 
+	// l2vzla: on macOS RENDERING is disabled (Build.h), which compiled this whole
+	// function away and made CLI texture export a silent no-op. Texture/cubemap
+	// export does not need the renderer, so handle it via IsA() when RENDERING
+	// is off (IsTexture()/IsTextureCube() are RENDERING-only virtuals).
+#if !RENDERING
+	if (!Mat) return;
+
+	if (Mat->IsA("Cubemap") || Mat->IsA("TextureCube3") || Mat->IsA("TextureCube4"))
+	{
+		ExportCubemap(Mat);
+		return;
+	}
+
+	if (Mat->IsA("Texture") || Mat->IsA("Texture2D"))
+	{
+		ExportTexture(Mat);
+		return;
+	}
+#endif
+
 #if RENDERING				// requires UUnrealMaterial::GetParams()
 
 	if (!Mat) return;
