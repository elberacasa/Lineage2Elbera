# Elbera root repo — ignore copyrighted assets, binaries, caches, secrets
# Tracked: our source, authored documentation, package dependency manifests,
# and selected presentation screenshots under docs/img/. Generated game data
# and local receipts remain on the operator's disk, not in the source release.

# macOS
.DS_Store

# Secrets
db-credentials.txt
.env
.env.*
!.env.example

# Logs
*.log

# Copyrighted NCSoft client assets + converted outputs (regenerable via tools/)
assets/gamedata/
assets/interlude/
assets/library/
assets/world/
assets/world-hd/
assets/audio/
assets/gamedata/icons/
# Newly decoded original quest prose and records stay local. Regenerate with
# tools/dat/export_quests.py; the public repository carries the decoder only.
assets/gamedata/quests.json
assets/gamedata/npcvisual.json
assets/gamedata/npcanimations.json
assets/gamedata/npcmaterials.json
assets/gamedata/dialogbox.json
assets/gamedata/questmark.json
Screenshots/

# aCis server — separate git repo with its own history (see server/.git)
server/

# Node dependencies (anywhere)
node_modules/

# Editor — regenerable model binaries, caches, verify screenshots
editor/settings.json
editor/characters/*.json
editor/characters/monsters/*.json
editor/characters/armor/manifest.json
editor/characters/weapons/
editor/cache/
editor/characters/models/
editor/characters/models_lq/
# Original hair meshes, material images and extraction receipts.
editor/characters/hair/
editor/characters/monsters/models/
# Armor paperdoll output, including its source-derived manifest.
editor/characters/armor/*/
editor/charcreate/verify_shots/
editor/world/verify_shots/

# Tools — built binaries, vendored third-party source, build outputs,
# samples, reference images, verify renders (our code stays tracked)
tools/bin/
tools/vendor/
tools/samples/
tools/reference/
tools/src/UEViewer/
tools/src/open-l2encdec/build/
tools/src/char_pipeline/verify/
tools/utx/test/
tools/upscale/bin/
tools/maps/out/

# Panel — runtime backups
panel/backups/
panel/config-catalog.json
panel/config-defaults.json

# Temp artifacts
tmp/

# Vendored third-party clones (own .git)
tools/src/open-l2encdec/

# ElberaSkin staged UI art — NCSoft PNGs extracted from your own client
# (regenerate: tools/ui/build_uiskin.py, tools/ui/build_font.py).
# The manifests beside them are also generated from the original client.
editor/world/ui/*.json
editor/world/ui/skin/
editor/world/ui/font/
editor/world/ui/atlas/
# (regenerate: tools/ui/mine_htmlart.py --emit) the textures NPC-dialog HTML
# names by runtime string, which no xdat-driven staging can see
editor/world/ui/htmlart/

# ElberaScript output — UnrealScript sources recovered from your own client's
# Interface.u / NWindow.u. NCSoft's code: reference only, never committed.
# (regenerate: tools/uscript/extract_uscript.py)
assets/uscript/

# Governor runtime state (cross-process lock)
gateway/.governor-state

# Runtime pidfiles
*.pid

# Audit/inspection screenshots — regenerable evidence, not source
editor/world/audit_shots/
editor/world/audit_report/
editor/world/sky_shots/
editor/world/ui_color_shots_before/
editor/world/ui_color_shots_after/
editor/world/ui_shots/
editor/world/ui_geom_shots/
editor/world/ui_geom_shots_before/
editor/world/ui_geom_shots_after/
editor/world/verify_shots/
editor/world/verify_*.json
gateway/test/capture-skills.json
gateway/test/road-to-town.json
tools/anim/*.json
tools/audit/*_baseline.json
!tools/audit/unsourced_baseline.json
!tools/audit/retail_gaps_baseline.json
tools/maps/maps/
tools/src/char_pipeline/*_baseline.json
tools/src/char_pipeline/f5_scale_check.png
tools/world/batch_failures.txt

# The owner's own reference screenshots — input to the work, not source
editor/world/human_shots/

# Outreach drafts and their screenshots — the owner's own marketing material,
# not part of the port. Kept local; regenerable via outreach/shots/capture.js.
outreach/
# Original-client-derived skill-training layout (Elbera Tools local output).
assets/gamedata/skilltraining.json
assets/gamedata/henna.json
assets/gamedata/recipes.json
assets/gamedata/skilltext.json
assets/gamedata/appearance.json
